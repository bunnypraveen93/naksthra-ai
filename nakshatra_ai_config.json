{
  "meta": {
    "name": "Nakshatra AI",
    "config_version": "1.2.0",
    "prompt_version": "v1.3",
    "updated": "2026-11-27",
    "notes": "Aligned with worker.js v1.3 history-aware live language continuity, unambiguous Romanized detection, reasoning, calculator verification, and anti-hallucination pipeline."
  },

