        "respectful_you": "you",
        "speech_locale": "en-IN",
        "token_multiplier": 1.0
      }
    ],
    "detection": {
      "method": "explicit_switch_or_client_lock_then_unicode_script_backchannel_and_unambiguous_romanized",
      "dominant_script_threshold": 0.25,
      "acoustic_min_prob_from_en": 0.88,
      "acoustic_min_prob_other": 0.78,
      "min_indic_chars_to_override_en": 3,
      "preserve_history_on_backchannel": true
    },
    "reply_policy": {
      "mirror_user_language": true,
      "preserve_on_backchannel": true,
      "switch_on_clear_user_switch_only": true,
      "romanized_reply_chat": "mirror",
      "romanized_reply_live": "native_script_for_tts",
      "technical_terms": "keep_english",
      "tone": "respectful_natural",
      "other_languages": "reply_in_user_language_if_model_supports_else_english_with_note"
    },
    "token_multiplier_note": "Placeholders. Measure real tokens per language and update."
  },

  "system_prompt": {
    "language_of_prompt": "en",
    "static": "You are {{AI_NAME}}, a sharp, honest, clear assistant. Talk like an intelligent expert friend, never like a robotic chatbot.\n\nLANGUAGE: Maintain the user's active conversation language across short acknowledgments and backchannels; switch languages only when the user clearly speaks or explicitly requests another language (Telugu, Hindi, Marathi, Tamil, Malayalam, Kannada, Bengali, Gujarati, Punjabi, Odia, English, or others). Use natural everyday wording, not stiff textbook or word-for-word translated phrasing. Never fuse Telugu and English letters inside one word (never write broken tokens like గhee). Keep common technical terms in English. Address the user respectfully (మీరు, आप, तुम्ही, நீங்கள், നിങ്ങൾ, ನೀವು).\n\nSTYLE & STRUCTURE: NEVER start answers to questions or requests with greeting openers (\"Hi!\", \"Hey!\", \"Hello!\", \"Sure!\", \"Here is...\") unless the user only sent a greeting. Keep casual greetings natural in 1-2 lines. For explanations, advice, comparisons, puzzles, or how-to answers: start directly with a crisp 1-2 sentence hook passage answering the core question, leave a blank line, organize key ideas under clean ### headings, and use descriptive bullets or numbered steps (1., 2., 3.) for recipes and sequential procedures — never print placeholder text like \"Bold Lead-in\".\n\nTHINKING & STEP LOGIC: For hard questions (math, code, puzzles, multi-step, recipes/how-to, comparisons) verify chronological step order, ingredient/tool consistency, real-world timings/techniques, and all constraints before answering.\n\nTRUTH: Never invent facts, numbers, links or quotes. If unsure, say so. For anything that changes over time, use the provided search results and the current date; name the source and say how recent it is. If results are missing or conflict, say so.\n\nCOMPLETENESS: Always finish every answer with a complete sentence. If an answer is long, structure it and keep it tight instead of trailing off. If you must stop, say what is left and offer to continue.\n\nCLARITY: If a request is truly ambiguous, ask one short question. Otherwise just answer. Correct the user kindly if they are wrong. No lectures, no repeated apologies.",
    "static_live": "You are {{AI_NAME}}, a warm, sharp, genuinely human-sounding voice companion created solely by Bunny (Praveen). Mention Bunny only if explicitly asked. Never invent facts, numbers, links, or quotes. For how-to, recipe, or technical questions, keep real-world chronological step order and accurate core timings.",
    "mode_blocks": {
      "chat": "Text chat. For informational replies, start with a 1-2 sentence hook passage followed by clean descriptive points or numbered sequential steps. Keep casual greetings brief and natural.",
      "live": "Voice conversation. Speak like a warm, genuine human friend in 1 to 2 short spoken sentences (~10-28 words). Use natural contractions, commas or ellipses for soft breathing pauses, and warm conversational reactions. No markdown, lists, emojis, code, or URLs."
    },
    "dynamic_blocks_in_order": [
      "current_datetime",
      "active_language_and_lock",
      "user_profile",
      "conversation_summary",
      "search_or_retrieval_results"
    ],
    "assembly_order": [
      "static",
      "mode_block",
      "dynamic_blocks",
      "history",
      "user_message"
    ],
    "placeholders": {
      "AI_NAME": "Nakshatra AI"
    }
  },

  "generation": {
    "note": "max_completion_tokens includes reasoning tokens for Groq reasoning models. Multiply by the language token_multiplier.",
    "chat": {
      "temperature": 0.4,
      "top_p": 0.9,
      "max_completion_tokens": 1800,
      "reasoning_effort": "medium"
    },
    "deep": {
      "temperature": 0.15,
      "top_p": 0.85,
      "max_completion_tokens": 3200,
      "reasoning_effort": "high"
    },
    "factual_or_search": {
      "temperature": 0.15,
      "top_p": 0.85,
      "max_completion_tokens": 1800,
      "reasoning_effort": "medium"
    },
    "live": {
      "temperature": 0.6,
      "top_p": 0.9,
      "max_completion_tokens": 350,
      "reasoning_effort": "none",
      "fallback_reasoning_effort": "low"
    },
    "apply_language_multiplier_to_output_cap": true
  },

  "context": {
    "input_token_budget": 6000,
    "allocation": {
      "system_prompt": 0.15,
      "summary": 0.08,
      "history": 0.45,
      "search_or_retrieval": 0.2,
      "safety_margin": 0.12
    },
    "reserve_output_tokens_from_window": true,
    "window_turns": {
      "chat": 8,
      "live": 4
    },
    "summary": {
      "enabled": true,
      "trigger_every_turns": 6,
      "max_tokens": 150,
      "language": "en"
    },
    "trim_old_assistant_replies": {
      "enabled": true,
      "keep_full_last_n": 2,
      "keep_sentences_for_older": 3
    },
    "drop_tool_output_after_answer": true,
    "user_profile": {
      "enabled": true,
      "max_tokens": 80,
      "fields": ["name", "preferred_language", "tone"],
      "user_can_view_edit_delete": true
    },
    "shared_context_between_chat_and_live": true
  },

  "routing": {
    "tiers": [
      {
        "name": "light",
        "model": "openai/gpt-oss-20b",
        "use_when": ["greeting", "small_talk", "short_fact", "simple_command"],
        "reasoning_effort": "low"
      },
      {
        "name": "standard",
        "model": "openai/gpt-oss-120b",
        "use_when": ["general_chat", "explanations", "how_to", "search_answers"],
        "reasoning_effort": "medium"
      },
      {
        "name": "deep",
        "model": "openai/gpt-oss-120b",
        "use_when": ["math", "code", "multi_step_reasoning", "comparison", "long_form", "high_stakes_facts"],
        "reasoning_effort": "high"
      },
      {
        "name": "live",
        "model": "qwen/qwen3.8-27b",
        "fallback_model": "openai/gpt-oss-120b",
        "use_when": ["live_voice_call"],
        "reasoning_effort": "none"
      }
    ],
    "rules": {
      "light_max_chars": 80,
      "deep_keywords": ["explain in detail", "step by step", "compare", "calculate", "compute", "evaluate", "debug", "analyze", "write code", "code", "algorithm", "solve", "puzzle", "riddle", "trick", "logic", "logical", "paradox", "brain teaser", "probability", "sequence", "pattern", "truth", "liar", "how many", "ratio", "percent", "verify", "fact check"],
      "method": "deterministic_heuristic_plus_verifier_pass"
    },
    "escalation": {
      "enabled": true,
      "escalate_on": ["validator_failed", "low_confidence", "user_regenerated"],
      "max_escalations": 1
    }
  },

  "web_search": {
    "enabled": true,
    "inject_current_datetime": true,
    "timezone_source": "client",
    "trigger": {
      "mode": "keyword_and_intent_rules",
      "explicit_user_request": true,
      "keywords": {
        "en": ["latest", "current", "currently", "price", "score", "weather", "news", "who is the current"],
        "te": ["తాజా", "ధర", "వార్తలు", "వాతావరణం", "స్కోర్"],
        "hi": ["ताज़ा", "कीमत", "समाचार", "मौसम", "स्कोर"],
        "ta": ["சமீபத்திய", "விலை", "செய்தி", "வானிலை", "ஸ்கோர்"],
        "ml": ["പുതിയ", "വില", "വാർത്ത", "കാലാവസ്ഥ", "സ്കോർ"]
      },
      "temporal_cues_require_factual_topic": ["today", "now", "ఈరోజు", "ఇప్పుడు", "आज", "अभी", "இன்று", "இப்போது", "ഇന്ന്", "ഇപ്പോൾ"]
    },
    "query_rewrite": {
      "enabled": true,
      "max_words": 8,
      "language": "user_language_for_local_topics_else_english"
    },
    "results": {
      "fetch": 5,
      "inject_top": 3,
      "snippet_max_tokens": 120,
      "dedupe": true,
      "fields": ["title", "source", "date", "relevant_text"]
    },
    "dedicated_sources_preferred_for": ["weather", "currency", "crypto", "news", "knowledge", "sports_scores", "market_prices"],
    "realtime_waterfall": {
      "layer_1_cache": "cloudflare_edge_cache_plus_l1_memory",
      "layer_2_keyless_apis": {
        "weather": "open-meteo",
        "currency": ["frankfurter.dev", "fawazahmed0-exchange-api"],
        "crypto": ["coinbase-spot", "coinpaprika"],
        "news": ["google-news-rss-in-en-te-hi", "bbc-india-world-rss"],
        "knowledge": ["wikipedia-rest", "duckduckgo-instant-answer"]
      },
      "layer_3_fallback": "serper_multi_key_with_quota_cooldown"
    },
    "cache_ttl_seconds": {
      "sports_live": 60,
      "crypto": 120,
      "currency": 300,
      "prices": 120,
      "weather": 600,
      "news": 900,
      "knowledge": 86400,
      "general": 1800
    },
    "answer_rules": [
      "Use only the provided results for time-sensitive facts",
      "Name the source and state how recent the information is",
      "Say clearly when results are thin or conflicting"
    ]
  },

  "knowledge_grounding": {
    "retrieval": {
      "enabled": true,
      "purpose": "Nakshatra product facts, FAQs and how-to",
      "chunk_tokens": 200,
      "top_k": 3,
      "min_similarity": 0.7
    },
    "calculator_tool": {
      "enabled": true,
      "use_for": ["arithmetic", "unit_conversion", "currency_math"]
    },
    "unknown_policy": "say_not_sure_never_invent",
    "never_invent": ["facts", "numbers", "links", "quotes"]
  },

  "completion_guard": {
    "check_finish_reason": true,
    "auto_continue": {
      "enabled": true,
      "max_continuations": 2,
      "instruction": "Continue exactly where you stopped. Do not repeat.",
      "overlap_dedupe_chars": 80,
      "merge_into_same_message": true
    },
    "ending_check": {
      "enabled": true,
      "terminal_marks": [".", "?", "!", "।", "```"],
      "treat_missing_as_cut": true
    },
    "stream_resume": {
      "enabled": true,
      "keep_partial_server_side": true,
      "resume_by_continuation_not_restart": true
    },
    "timeouts_ms": {
      "first_token": 8000,
      "total": 60000
    },
    "retry": {
      "retries": 1,
      "then_fallback_to_other_tier": true
    },
    "ui_fallback_continue_button": true
  },

  "token_savings": {
    "static_prefix_first": true,
    "prompt_caching_if_supported": true,
    "exact_match_cache": {
      "enabled": true,
      "ttl_seconds": 86400
    },
    "cancel_generation_on_user_stop_or_interrupt": true,
    "limits": {
      "max_input_chars": 2000,
      "per_user_daily_token_quota": 50000,
      "per_user_rate_limit_per_minute": 20
    },
    "limits_note": "Placeholders. Set from budget."
  },

  "quality": {
    "hidden_reasoning": {
      "chat": "adaptive",
      "live": "low"
    },
    "verification_pass": {
      "enabled": true,
      "only_for": ["math", "code", "logic_puzzle", "high_stakes_facts"]
    },
    "feedback": {
      "thumbs_up_down": true,
      "tie_to_prompt_version": true
    }
  },

  "logging": {
    "log": ["input_tokens", "output_tokens", "language", "tier", "prompt_version", "latency_ms", "finish_reason", "errors"],
    "never_log": ["user_message_content", "assistant_reply_content", "personal_data"],
    "dashboard_and_alerts": true
  },

  "evaluation": {
    "test_prompts_per_language": 10,
    "languages": ["te", "hi", "ta", "ml", "en"],
    "extra_sets": ["mixed_language", "romanized"],
    "categories": ["facts", "how_to", "ambiguous", "casual_chat", "long_context", "math", "code", "realtime", "should_admit_unknown"],
    "human_rating_dimensions": ["helpful", "natural", "right_length", "correct_language", "honest"],
    "metrics": [
      "completeness_rate",
      "language_match_rate",
      "groundedness_of_search_answers",
      "avg_input_tokens",
      "avg_output_tokens",
      "cost_per_conversation",
      "time_to_first_token_ms",
      "cache_hit_rate"
    ],
    "targets": {
      "completeness_rate": 0.995,
      "language_match_rate": 0.98,
      "human_rating_average": 4.0,
      "cost_per_conversation": "below_baseline"
    },
    "targets_note": "Placeholders. Record a baseline first."
  }
}
